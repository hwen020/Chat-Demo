CHATFLOW_DB_PASSWORD=chatflow
AI_PORT=8080
OPENAI_API_KEY=
# Required when enabling OpenAI. Supply the configured text model and its
# input/output prices as integers in micro-USD per million tokens.
# AI_OPENAI_MODELS='{"model-id":[INPUT_MICROUSD,OUTPUT_MICROUSD]}'
AI_MAX_INPUT_TOKENS=8192
AI_MAX_OUTPUT_TOKENS=1024
AI_USER_DAILY_MICROUSD=250000
AI_GLOBAL_DAILY_MICROUSD=2000000

# For native development, export these values to the API process.
# DATABASE_URL=postgresql+psycopg://chatflow:chatflow@127.0.0.1:55432/chatflow
# APP_ORIGINS=http://127.0.0.1:8000
# COOKIE_SECURE=0
# STATIC_DIR=/absolute/path/to/ai-chat/web/dist
